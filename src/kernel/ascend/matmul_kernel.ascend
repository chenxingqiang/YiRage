 * Ascend Matrix Multiplication Kernel
 * 
 * Fingerprint verification for Huawei Ascend NPU backend.
 * 
 * When use_npu_memory is true:
 *   - Copy data from NPU to CPU
 *   - Compute fingerprint on CPU
 *   - Copy result back to NPU
 */

#include "kernel/device_memory_manager.h"
#include "kernel/graph.h"
#include "kernel/matmul.h"
#include "utils/fingerprint_functions.h"
#include <cassert>
#include <cstdlib>

#ifdef __ASCEND__
#include "acl/acl.h"
#include "acl/acl_rt.h"
#endif

namespace yirage {
namespace kernel {

using namespace yirage::type;
using namespace yirage::config;
using namespace yirage::utils;

#ifdef YIRAGE_FINGERPRINT_USE_ASCEND

// CPU implementation of matmul fingerprint
static void compute_matmul_fp_cpu(
    FPType *A_ptr, FPType *B_ptr, FPType *C_ptr,
    int num_batches, int row_A, int column_A, int column_B) {
  int row_B = column_A;
  int row_C = row_A;
  int column_C = column_B;
  
  for (int b = 0; b < num_batches; b++) {
    for (int i = 0; i < row_C; i++) {
      for (int j = 0; j < column_C; j++) {
        FPType result = 0;
        for (int p = 0; p < row_B; p++) {
          FPType x = A_ptr[b * row_C * row_B + i * row_B + p];
          FPType y = B_ptr[b * row_B * column_C + p * column_C + j];
          result = compute_add_fingerprint(result, compute_mul_fingerprint(x, y));
        }
        C_ptr[b * row_C * column_C + i * column_C + j] = result;
      }
    }
  }
}

bool KNMatmulOp::fingerprint(void) {
  // Currently assert a single GPU/NPU
  assert(kgraph->gpu_dim.y == 1);
  assert(kgraph->gpu_dim.z == 1);

  int num_dims = input_tensors[0].num_dims;
  int row_A = input_tensors[0].dim[num_dims - 2];
  int column_A = input_tensors[0].dim[num_dims - 1];
  int row_B = input_tensors[1].dim[num_dims - 2];
  int column_B = input_tensors[1].dim[num_dims - 1];
  int row_C = output_tensors[0].dim[num_dims - 2];
  int column_C = output_tensors[0].dim[num_dims - 1];
  assert(column_A == row_B);
  assert(row_C == row_A);
  assert(column_C == column_B);
  
  int num_batches = 1;
  for (int i = 0; i < num_dims - 2; i++) {
    num_batches *= input_tensors[0].dim[i];
  }
  
  yirage::kernel::DeviceMemoryManager *dmm =
      yirage::kernel::DeviceMemoryManager::get_instance();
  
  // Safety checks
  if (input_tensors[0].fp_offset < 0 || input_tensors[1].fp_offset < 0 ||
      output_tensors[0].fp_offset < 0) {
    return false;
  }

  size_t A_size = num_batches * row_A * column_A * sizeof(FPType);
  size_t B_size = num_batches * row_B * column_B * sizeof(FPType);
  size_t C_size = num_batches * row_C * column_C * sizeof(FPType);

  for (int gpu_id = 0; gpu_id < kgraph->gpu_dim.x; gpu_id++) {
    if (dmm->fp_base_ptr[gpu_id] == nullptr) {
      return false;
    }
    
    FPType *A_fp_ptr = reinterpret_cast<FPType *>(
        dmm->fp_base_ptr[gpu_id] + input_tensors[0].fp_offset);
    FPType *B_fp_ptr = reinterpret_cast<FPType *>(
        dmm->fp_base_ptr[gpu_id] + input_tensors[1].fp_offset);
    FPType *C_fp_ptr = reinterpret_cast<FPType *>(
        dmm->fp_base_ptr[gpu_id] + output_tensors[0].fp_offset);
    
#ifdef __ASCEND__
    if (dmm->use_npu_memory) {
      // Data is on NPU - need to copy to CPU, compute, copy back
      FPType *host_A = reinterpret_cast<FPType*>(malloc(A_size));
      FPType *host_B = reinterpret_cast<FPType*>(malloc(B_size));
      FPType *host_C = reinterpret_cast<FPType*>(malloc(C_size));
      
      if (!host_A || !host_B || !host_C) {
        free(host_A);
        free(host_B);
        free(host_C);
        return false;
      }
      
      // Copy from NPU to CPU
      aclrtMemcpy(host_A, A_size, A_fp_ptr, A_size, ACL_MEMCPY_DEVICE_TO_HOST);
      aclrtMemcpy(host_B, B_size, B_fp_ptr, B_size, ACL_MEMCPY_DEVICE_TO_HOST);
      
      // Compute on CPU
      compute_matmul_fp_cpu(host_A, host_B, host_C, 
                            num_batches, row_A, column_A, column_B);
      
      // Copy result back to NPU
      aclrtMemcpy(C_fp_ptr, C_size, host_C, C_size, ACL_MEMCPY_HOST_TO_DEVICE);
      
      free(host_A);
      free(host_B);
      free(host_C);
    } else {
      // Data is on CPU (fallback mode)
      compute_matmul_fp_cpu(A_fp_ptr, B_fp_ptr, C_fp_ptr,
                            num_batches, row_A, column_A, column_B);
    }
#else
    // Non-Ascend build: compute on CPU
    compute_matmul_fp_cpu(A_fp_ptr, B_fp_ptr, C_fp_ptr,
                          num_batches, row_A, column_A, column_B);
#endif
  }
  return true;
}

#endif // YIRAGE_FINGERPRINT_USE_ASCEND

} // namespace kernel
} // namespace yirage
