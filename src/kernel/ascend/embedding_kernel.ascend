// =============================================================================
// CPU Reference Implementations
// =============================================================================

void embedding_lookup_cpu(
    const int* token_ids,
    const float* embedding_table,
    float* output,
    int num_tokens,
    int embedding_dim,
    int vocab_size
) {
    for (int t = 0; t < num_tokens; t++) {
        int token_id = token_ids[t];
        if (token_id < 0 || token_id >= vocab_size) continue;
        
        const float* src = embedding_table + token_id * embedding_dim;
        float* dst = output + t * embedding_dim;
        
        for (int d = 0; d < embedding_dim; d++) {
            dst[d] = src[d];
        }
    }
}

void add_position_embedding_cpu(
    float* embeddings,
    const float* position_table,
    const int* positions,
    int num_tokens,
    int embedding_dim,
    int max_positions
) {
    for (int t = 0; t < num_tokens; t++) {
        int pos = positions[t];
        if (pos < 0 || pos >= max_positions) continue;
        
        float* emb = embeddings + t * embedding_dim;
        const float* pos_emb = position_table + pos * embedding_dim;
        
        for (int d = 0; d < embedding_dim; d++) {
            emb[d] += pos_emb[d];
        }
    }
}

void compute_sinusoidal_embedding_cpu(
    float* output,
    int max_positions,
    int embedding_dim
) {
    int half_dim = embedding_dim / 2;
    
    for (int pos = 0; pos < max_positions; pos++) {
        for (int i = 0; i < half_dim; i++) {
            float freq = 1.0f / powf(10000.0f, (float)i / half_dim);
            float angle = pos * freq;
            
            output[pos * embedding_dim + i * 2] = sinf(angle);
            output[pos * embedding_dim + i * 2 + 1] = cosf(angle);
        }
    }
}

void lm_head_cpu(
    const float* hidden,
    const float* weight,
    float* logits,
    int batch_size,
    int hidden_dim,
    int vocab_size
) {
    // hidden @ weight.T
    for (int b = 0; b < batch_size; b++) {
        const float* h = hidden + b * hidden_dim;
        float* out = logits + b * vocab_size;
        
        for (int v = 0; v < vocab_size; v++) {
            const float* w = weight + v * hidden_dim;
            float sum = 0.0f;
            for (int d = 0; d < hidden_dim; d++) {
                sum += h[d] * w[d];
            }
            out[v] = sum;
        }
    }
}

int argmax_cpu(const float* logits, int vocab_size) {
    int max_idx = 0;
    float max_val = logits[0];
    for (int i = 1; i < vocab_size; i++) {
        if (logits[i] > max_val) {
            max_val = logits[i];
            max_idx = i;
        }
    }
    return max_idx;
}

// =============================================================================
// TBE Kernel Sources
// =============================================================================

const char* EMBEDDING_LOOKUP_TBE_SOURCE = R"(
import te
from te import tik
from te.platform import get_soc_spec

def embedding_lookup_tbe(vocab_size, embedding_dim, num_tokens, dtype="float16"):
    """TBE Embedding lookup for Ascend"""
    
    tik_instance = tik.Tik()
    
    # Input tensors
    token_ids_gm = tik_instance.Tensor("int32", [num_tokens],
                                       name="token_ids_gm", scope=tik.scope_gm)
    embedding_table_gm = tik_instance.Tensor(dtype, [vocab_size, embedding_dim],
                                             name="embedding_table_gm", scope=tik.scope_gm)
    output_gm = tik_instance.Tensor(dtype, [num_tokens, embedding_dim],
                                    name="output_gm", scope=tik.scope_gm)
    
    core_num = get_soc_spec("CORE_NUM")
    tokens_per_core = (num_tokens + core_num - 1) // core_num
    
    with tik_instance.for_range(0, core_num, block_num=core_num) as core_idx:
        token_start = core_idx * tokens_per_core
        token_end = min(token_start + tokens_per_core, num_tokens)
        
        with tik_instance.for_range(token_start, token_end) as token_idx:
            # Load token ID
            token_id_ub = tik_instance.Tensor("int32", [1], name="token_id_ub", scope=tik.scope_ubuf)
            tik_instance.data_move(token_id_ub, token_ids_gm[token_idx:token_idx+1], 0, 1, 1, 0, 0)
            
            token_id = token_id_ub[0]
            
            # Bounds check
            with tik_instance.if_scope(tik.all(token_id >= 0, token_id < vocab_size)):
                # Load embedding vector
                emb_ub = tik_instance.Tensor(dtype, [embedding_dim], name="emb_ub", scope=tik.scope_ubuf)
                tik_instance.data_move(emb_ub, embedding_table_gm[token_id, :], 0, 1, embedding_dim // 16, 0, 0)
                
                # Store to output
                tik_instance.data_move(output_gm[token_idx, :], emb_ub, 0, 1, embedding_dim // 16, 0, 0)
    
    return tik_instance

)";

const char* LM_HEAD_TBE_SOURCE = R"(
import te
from te import tik
from te.platform import get_soc_spec

def lm_head_tbe(batch_size, hidden_dim, vocab_size, dtype="float16"):
    """TBE LM Head (output projection) for Ascend using Cube Unit"""
    
    tik_instance = tik.Tik()
    
    # Input tensors
    hidden_gm = tik_instance.Tensor(dtype, [batch_size, hidden_dim],
                                    name="hidden_gm", scope=tik.scope_gm)
    weight_gm = tik_instance.Tensor(dtype, [vocab_size, hidden_dim],
                                    name="weight_gm", scope=tik.scope_gm)
    logits_gm = tik_instance.Tensor(dtype, [batch_size, vocab_size],
                                    name="logits_gm", scope=tik.scope_gm)
    
    # Tile sizes for Cube Unit
    TILE_M = 16  # batch tile
    TILE_N = 256  # vocab tile
    TILE_K = hidden_dim
    
    core_num = get_soc_spec("CORE_NUM")
    
    # Process using Cube matmul: hidden @ weight.T
    num_vocab_tiles = (vocab_size + TILE_N - 1) // TILE_N
    
    with tik_instance.for_range(0, core_num, block_num=core_num) as core_idx:
        tiles_per_core = (num_vocab_tiles + core_num - 1) // core_num
        tile_start = core_idx * tiles_per_core
        tile_end = min(tile_start + tiles_per_core, num_vocab_tiles)
        
        with tik_instance.for_range(tile_start, tile_end) as tile_idx:
            vocab_start = tile_idx * TILE_N
            vocab_end = min(vocab_start + TILE_N, vocab_size)
            actual_n = vocab_end - vocab_start
            
            # L1 buffers
            hidden_l1 = tik_instance.Tensor(dtype, [batch_size, hidden_dim],
                                           name="hidden_l1", scope=tik.scope_cbuf)
            weight_l1 = tik_instance.Tensor(dtype, [actual_n, hidden_dim],
                                           name="weight_l1", scope=tik.scope_cbuf)
            result_ub = tik_instance.Tensor(dtype, [batch_size, actual_n],
                                           name="result_ub", scope=tik.scope_ubuf)
            
            # Load hidden (all batches)
            tik_instance.data_move(hidden_l1, hidden_gm, 0, 1, batch_size * hidden_dim // 16, 0, 0)
            
            # Load weight tile (transposed access for W.T)
            tik_instance.data_move(weight_l1, weight_gm[vocab_start:vocab_end, :], 
                                  0, 1, actual_n * hidden_dim // 16, 0, 0)
            
            # Cube matmul: result = hidden @ weight_l1.T
            tik_instance.matmul(result_ub, hidden_l1, weight_l1, batch_size, actual_n, hidden_dim, True)
            
            # Store result
            tik_instance.data_move(logits_gm[:, vocab_start:vocab_end], result_ub,
                                  0, 1, batch_size * actual_n // 16, 0, 0)
    
    return tik_instance

)";

const char* ARGMAX_TBE_SOURCE = R"(
import te
from te import tik
from te.platform import get_soc_spec

def argmax_tbe(batch_size, vocab_size, dtype="float32"):
    """TBE Argmax for greedy decoding"""
    
    tik_instance = tik.Tik()
    
    # Input tensors
    logits_gm = tik_instance.Tensor(dtype, [batch_size, vocab_size],
                                    name="logits_gm", scope=tik.scope_gm)
    output_gm = tik_instance.Tensor("int32", [batch_size],
                                    name="output_gm", scope=tik.scope_gm)
    
    core_num = get_soc_spec("CORE_NUM")
    
    with tik_instance.for_range(0, core_num, block_num=core_num) as core_idx:
        batches_per_core = (batch_size + core_num - 1) // core_num
        batch_start = core_idx * batches_per_core
        batch_end = min(batch_start + batches_per_core, batch_size)
        
        with tik_instance.for_range(batch_start, batch_end) as batch_idx:
            # Load logits for this batch
            logits_ub = tik_instance.Tensor(dtype, [vocab_size],
                                           name="logits_ub", scope=tik.scope_ubuf)
            tik_instance.data_move(logits_ub, logits_gm[batch_idx, :], 0, 1, vocab_size // 8, 0, 0)
            
            # Find max and argmax using vector reduce
            max_val_ub = tik_instance.Tensor(dtype, [1], name="max_val_ub", scope=tik.scope_ubuf)
            max_idx_ub = tik_instance.Tensor("int32", [1], name="max_idx_ub", scope=tik.scope_ubuf)
            
            tik_instance.vec_reduce_max(max_val_ub, logits_ub, vocab_size // 64, 8)
            
            # Find index of max (scan through and compare)
            # This is a simplification - real implementation would use optimized scan
            
            # Store result
            tik_instance.data_move(output_gm[batch_idx:batch_idx+1], max_idx_ub, 0, 1, 1, 0, 0)
    
    return tik_instance

)";

// =============================================================================
// CANN-based Implementations
// =============================================================================

#ifdef __ASCEND__

aclError launch_embedding_lookup_ascend(
    const int32_t* token_ids,
    const void* embedding_table,
    void* output,
    int64_t num_tokens,
    int64_t embedding_dim,
    int64_t vocab_size,
    aclDataType dtype,
    aclrtStream stream
) {
    // Use CANN's optimized embedding lookup
    int64_t indices_dims[] = {num_tokens};
    int64_t table_dims[] = {vocab_size, embedding_dim};
    int64_t output_dims[] = {num_tokens, embedding_dim};
    
    aclTensorDesc* indices_desc = aclCreateTensorDesc(ACL_INT32, 1, indices_dims, ACL_FORMAT_ND);
    aclTensorDesc* table_desc = aclCreateTensorDesc(dtype, 2, table_dims, ACL_FORMAT_ND);
    aclTensorDesc* output_desc = aclCreateTensorDesc(dtype, 2, output_dims, ACL_FORMAT_ND);
    
    // aclnnEmbedding or aclnnGather
    size_t workspace_size = 0;
    aclOpExecutor* executor = nullptr;
    
    // Get workspace and execute
    // aclnnGatherGetWorkspaceSize(...)
    // aclnnGather(...)
    
    aclDestroyTensorDesc(indices_desc);
    aclDestroyTensorDesc(table_desc);
    aclDestroyTensorDesc(output_desc);
    
    return ACL_SUCCESS;
}

aclError launch_lm_head_ascend(
    const void* hidden,
    const void* weight,
    void* logits,
    int64_t batch_size,
    int64_t hidden_dim,
    int64_t vocab_size,
    aclDataType dtype,
    aclrtStream stream
) {
    // Use CANN's MatMul: hidden @ weight.T
    int64_t hidden_dims[] = {batch_size, hidden_dim};
    int64_t weight_dims[] = {vocab_size, hidden_dim};
    int64_t logits_dims[] = {batch_size, vocab_size};
    
    aclTensorDesc* hidden_desc = aclCreateTensorDesc(dtype, 2, hidden_dims, ACL_FORMAT_ND);
    aclTensorDesc* weight_desc = aclCreateTensorDesc(dtype, 2, weight_dims, ACL_FORMAT_ND);
    aclTensorDesc* logits_desc = aclCreateTensorDesc(dtype, 2, logits_dims, ACL_FORMAT_ND);
    
    // aclnnMatmul with transB=true
    size_t workspace_size = 0;
    aclOpExecutor* executor = nullptr;
    
    // Execute matmul
    
    aclDestroyTensorDesc(hidden_desc);
    aclDestroyTensorDesc(weight_desc);
    aclDestroyTensorDesc(logits_desc);
    
    return ACL_SUCCESS;
}

aclError launch_argmax_ascend(
    const void* logits,
    int32_t* output,
    int64_t batch_size,
    int64_t vocab_size,
    aclDataType dtype,
    aclrtStream stream
) {
    int64_t logits_dims[] = {batch_size, vocab_size};
    int64_t output_dims[] = {batch_size};
    
    aclTensorDesc* logits_desc = aclCreateTensorDesc(dtype, 2, logits_dims, ACL_FORMAT_ND);
    aclTensorDesc* output_desc = aclCreateTensorDesc(ACL_INT32, 1, output_dims, ACL_FORMAT_ND);
    
    // aclnnArgmax along axis=1
    size_t workspace_size = 0;
    aclOpExecutor* executor = nullptr;
    
    // Execute argmax
    
    aclDestroyTensorDesc(logits_desc);
    aclDestroyTensorDesc(output_desc);
    
    return ACL_SUCCESS;
}

