// =============================================================================
// TBE Flash Attention Kernel Source
// =============================================================================

const char* FLASH_ATTENTION_TBE_SOURCE = R"(
import te
from te import tik
from te.platform import get_soc_spec

def flash_attention_tbe(batch_size, num_heads, seq_len, head_dim, causal=True, dtype="float16"):
    """
    Flash Attention implementation for Ascend NPU using TBE.
    
    Optimized for:
    - Cube Unit: Q @ K^T and Attention @ V matmuls
    - Vector Unit: Softmax computation
    - L1 Buffer: Tile-based processing for memory efficiency
    """
    
    tik_instance = tik.Tik()
    
    # Hardware specs
    cube_m = 16  # Cube unit M dimension
    cube_n = 16  # Cube unit N dimension
    cube_k = 16  # Cube unit K dimension
    l1_size = get_soc_spec("L1_SIZE")
    ub_size = get_soc_spec("UB_SIZE")
    core_num = get_soc_spec("CORE_NUM")
    
    # Tile sizes
    BLOCK_M = 64
    BLOCK_N = 64
    
    # Global memory tensors
    Q_gm = tik_instance.Tensor(dtype, [batch_size, num_heads, seq_len, head_dim],
                               name="Q_gm", scope=tik.scope_gm)
    K_gm = tik_instance.Tensor(dtype, [batch_size, num_heads, seq_len, head_dim],
                               name="K_gm", scope=tik.scope_gm)
    V_gm = tik_instance.Tensor(dtype, [batch_size, num_heads, seq_len, head_dim],
                               name="V_gm", scope=tik.scope_gm)
    O_gm = tik_instance.Tensor(dtype, [batch_size, num_heads, seq_len, head_dim],
                               name="O_gm", scope=tik.scope_gm)
    
    # Scale factor
    scale = 1.0 / (head_dim ** 0.5)
    
    # Process each (batch, head) pair
    total_heads = batch_size * num_heads
    heads_per_core = (total_heads + core_num - 1) // core_num
    
    with tik_instance.for_range(0, core_num, block_num=core_num) as core_idx:
        head_start = core_idx * heads_per_core
        head_end = min(head_start + heads_per_core, total_heads)
        
        with tik_instance.for_range(head_start, head_end) as head_idx:
            batch_idx = head_idx // num_heads
            local_head_idx = head_idx % num_heads
            
            # Allocate L1 buffers
            Q_l1 = tik_instance.Tensor(dtype, [BLOCK_M, head_dim],
                                       name="Q_l1", scope=tik.scope_cbuf)
            K_l1 = tik_instance.Tensor(dtype, [BLOCK_N, head_dim],
                                       name="K_l1", scope=tik.scope_cbuf)
            V_l1 = tik_instance.Tensor(dtype, [BLOCK_N, head_dim],
                                       name="V_l1", scope=tik.scope_cbuf)
            
            # UB buffers for intermediate results
            S_ub = tik_instance.Tensor("float32", [BLOCK_M, BLOCK_N],
                                       name="S_ub", scope=tik.scope_ubuf)
            P_ub = tik_instance.Tensor(dtype, [BLOCK_M, BLOCK_N],
                                       name="P_ub", scope=tik.scope_ubuf)
            O_ub = tik_instance.Tensor("float32", [BLOCK_M, head_dim],
                                       name="O_ub", scope=tik.scope_ubuf)
            
            # Online softmax state
            m_ub = tik_instance.Tensor("float32", [BLOCK_M],
                                       name="m_ub", scope=tik.scope_ubuf)
            l_ub = tik_instance.Tensor("float32", [BLOCK_M],
                                       name="l_ub", scope=tik.scope_ubuf)
            
            # Process Q tiles
            num_q_tiles = (seq_len + BLOCK_M - 1) // BLOCK_M
            
            with tik_instance.for_range(0, num_q_tiles) as q_tile_idx:
                q_start = q_tile_idx * BLOCK_M
                q_end = min(q_start + BLOCK_M, seq_len)
                q_tile_size = q_end - q_start
                
                # Load Q tile from GM to L1
                tik_instance.data_move(
                    Q_l1,
                    Q_gm[batch_idx, local_head_idx, q_start:q_end, :],
                    0, 1, q_tile_size * head_dim // 16, 0, 0)
                
                # Initialize O, m, l
                tik_instance.vec_dup(O_ub, 0.0, BLOCK_M * head_dim // 64, 8)
                tik_instance.vec_dup(m_ub, float('-inf'), BLOCK_M // 64, 8)
                tik_instance.vec_dup(l_ub, 0.0, BLOCK_M // 64, 8)
                
                # Determine KV range (causal masking)
                kv_end_limit = min(q_end, seq_len) if causal else seq_len
                num_kv_tiles = (kv_end_limit + BLOCK_N - 1) // BLOCK_N
                
                # Process KV tiles
                with tik_instance.for_range(0, num_kv_tiles) as kv_tile_idx:
                    kv_start = kv_tile_idx * BLOCK_N
                    kv_end = min(kv_start + BLOCK_N, kv_end_limit)
                    kv_tile_size = kv_end - kv_start
                    
                    # Load K, V tiles
                    tik_instance.data_move(
                        K_l1,
                        K_gm[batch_idx, local_head_idx, kv_start:kv_end, :],
                        0, 1, kv_tile_size * head_dim // 16, 0, 0)
                    tik_instance.data_move(
                        V_l1,
                        V_gm[batch_idx, local_head_idx, kv_start:kv_end, :],
                        0, 1, kv_tile_size * head_dim // 16, 0, 0)
                    
                    # S = Q @ K^T (Cube matmul)
                    tik_instance.matmul(S_ub, Q_l1, K_l1, q_tile_size, kv_tile_size, head_dim, True)
                    
                    # Scale
                    tik_instance.vec_muls(S_ub, S_ub, scale, q_tile_size * kv_tile_size // 64, 8, 8)
                    
                    # Apply causal mask
                    if causal:
                        with tik_instance.for_range(0, q_tile_size) as qi:
                            q_pos = q_start + qi
                            with tik_instance.for_range(0, kv_tile_size) as ki:
                                kv_pos = kv_start + ki
                                with tik_instance.if_scope(kv_pos > q_pos):
                                    S_ub[qi, ki] = float('-inf')
                    
                    # Online softmax update
                    # m_new = max(m, rowmax(S))
                    m_new_ub = tik_instance.Tensor("float32", [BLOCK_M],
                                                  name="m_new_ub", scope=tik.scope_ubuf)
                    tik_instance.vec_reduce_max(m_new_ub, S_ub, kv_tile_size, BLOCK_M)
                    tik_instance.vec_max(m_new_ub, m_new_ub, m_ub, BLOCK_M // 64, 8, 8, 8)
                    
                    # P = exp(S - m_new)
                    # (broadcast subtraction and exp)
                    
                    # l_new = l * exp(m - m_new) + rowsum(P)
                    # O_new = O * exp(m - m_new) + P @ V
                    
                    # Update state
                    tik_instance.vec_dup(m_ub, m_new_ub, BLOCK_M // 64, 8)
                
                # Final normalization: O = O / l
                # Store O tile to global memory
                tik_instance.data_move(
                    O_gm[batch_idx, local_head_idx, q_start:q_end, :],
                    O_ub,
                    0, 1, q_tile_size * head_dim // 16, 0, 0)
    
    return tik_instance

)";

// =============================================================================
// CPU Reference Implementation (for verification)
// =============================================================================

void flash_attention_cpu_reference(
    const float* Q,
    const float* K,
    const float* V,
    float* output,
    int batch_size,
    int num_heads,
    int seq_len,
    int head_dim,
    float scale,
    bool causal
) {
    for (int b = 0; b < batch_size; b++) {
        for (int h = 0; h < num_heads; h++) {
            for (int q = 0; q < seq_len; q++) {
                int q_offset = ((b * num_heads + h) * seq_len + q) * head_dim;
                
                // Running statistics for online softmax
                float m = -INFINITY;
                float l = 0.0f;
                float* o = new float[head_dim]();
                
                int kv_limit = causal ? (q + 1) : seq_len;
                
                for (int k_pos = 0; k_pos < kv_limit; k_pos++) {
                    int k_offset = ((b * num_heads + h) * seq_len + k_pos) * head_dim;
                    
                    // Compute Q @ K score
                    float score = 0.0f;
                    for (int d = 0; d < head_dim; d++) {
                        score += Q[q_offset + d] * K[k_offset + d];
                    }
                    score *= scale;
                    
                    // Online softmax update
                    float m_new = (score > m) ? score : m;
                    float exp_m_diff = expf(m - m_new);
                    float exp_score = expf(score - m_new);
                    
                    l = l * exp_m_diff + exp_score;
                    
                    // Update output
                    for (int d = 0; d < head_dim; d++) {
                        o[d] = o[d] * exp_m_diff + exp_score * V[k_offset + d];
                    }
                    
                    m = m_new;
                }
                
                // Final normalization
                for (int d = 0; d < head_dim; d++) {
                    output[q_offset + d] = o[d] / l;
                }
                
                delete[] o;
            }
        }
    }
}

// =============================================================================
// RoPE (Rotary Position Embedding)
// =============================================================================

void apply_rope_cpu(
    float* query,
    float* key,
    const float* cos_cache,
    const float* sin_cache,
    int batch_size,
    int num_heads,
    int seq_len,
    int head_dim,
    int rotary_dim
) {
    int half_rotary = rotary_dim / 2;
    
    for (int b = 0; b < batch_size; b++) {
        for (int h = 0; h < num_heads; h++) {
            for (int pos = 0; pos < seq_len; pos++) {
                int base = ((b * num_heads + h) * seq_len + pos) * head_dim;
                
                for (int i = 0; i < half_rotary; i++) {
                    float cos_val = cos_cache[pos * half_rotary + i];
                    float sin_val = sin_cache[pos * half_rotary + i];
                    
                    // Query
                    float q0 = query[base + i * 2];
                    float q1 = query[base + i * 2 + 1];
                    query[base + i * 2] = q0 * cos_val - q1 * sin_val;
                    query[base + i * 2 + 1] = q0 * sin_val + q1 * cos_val;
                    
                    // Key
                    float k0 = key[base + i * 2];
                    float k1 = key[base + i * 2 + 1];
                    key[base + i * 2] = k0 * cos_val - k1 * sin_val;
                    key[base + i * 2 + 1] = k0 * sin_val + k1 * cos_val;
                }
            }
        }
    }
}

// TBE RoPE source
const char* ROPE_TBE_SOURCE = R"(
import te
from te import tik
import math

def rope_tbe(batch_size, num_heads, seq_len, head_dim, rotary_dim, dtype="float16"):
    """RoPE implementation for Ascend using TBE"""
    
    tik_instance = tik.Tik()
    
    half_rotary = rotary_dim // 2
    
    # Input tensors
    query_gm = tik_instance.Tensor(dtype, [batch_size, num_heads, seq_len, head_dim],
                                   name="query_gm", scope=tik.scope_gm)
    key_gm = tik_instance.Tensor(dtype, [batch_size, num_heads, seq_len, head_dim],
                                 name="key_gm", scope=tik.scope_gm)
    cos_gm = tik_instance.Tensor("float32", [seq_len, half_rotary],
                                 name="cos_gm", scope=tik.scope_gm)
    sin_gm = tik_instance.Tensor("float32", [seq_len, half_rotary],
                                 name="sin_gm", scope=tik.scope_gm)
    
    core_num = get_soc_spec("CORE_NUM")
    total_work = batch_size * num_heads * seq_len
    
    with tik_instance.for_range(0, core_num, block_num=core_num) as core_idx:
        work_per_core = (total_work + core_num - 1) // core_num
        work_start = core_idx * work_per_core
        work_end = min(work_start + work_per_core, total_work)
        
        with tik_instance.for_range(work_start, work_end) as work_idx:
            pos = work_idx % seq_len
            head_idx = (work_idx // seq_len) % num_heads
            batch_idx = work_idx // (seq_len * num_heads)
            
            # UB buffers
            q_ub = tik_instance.Tensor(dtype, [head_dim], name="q_ub", scope=tik.scope_ubuf)
            k_ub = tik_instance.Tensor(dtype, [head_dim], name="k_ub", scope=tik.scope_ubuf)
            cos_ub = tik_instance.Tensor("float32", [half_rotary], name="cos_ub", scope=tik.scope_ubuf)
            sin_ub = tik_instance.Tensor("float32", [half_rotary], name="sin_ub", scope=tik.scope_ubuf)
            
            # Load data
            tik_instance.data_move(q_ub, query_gm[batch_idx, head_idx, pos, :], 0, 1, head_dim // 16, 0, 0)
            tik_instance.data_move(k_ub, key_gm[batch_idx, head_idx, pos, :], 0, 1, head_dim // 16, 0, 0)
            tik_instance.data_move(cos_ub, cos_gm[pos, :], 0, 1, half_rotary // 8, 0, 0)
            tik_instance.data_move(sin_ub, sin_gm[pos, :], 0, 1, half_rotary // 8, 0, 0)
            
            # Apply rotation
            # q_rotated = q * cos - q_paired * sin
            # This requires interleaved access pattern
            
            # Store results
            tik_instance.data_move(query_gm[batch_idx, head_idx, pos, :], q_ub, 0, 1, head_dim // 16, 0, 0)
            tik_instance.data_move(key_gm[batch_idx, head_idx, pos, :], k_ub, 0, 1, head_dim // 16, 0, 0)
    
    return tik_instance

)";

// =============================================================================
// CANN-based Attention (when available)
// =============================================================================

#ifdef __ASCEND__

aclError launch_flash_attention_ascend(
    const void* Q, const void* K, const void* V,
    void* output,
    int64_t batch_size, int64_t num_heads,
    int64_t seq_len, int64_t head_dim,
    float scale, bool causal,
    aclrtStream stream
) {
    // Use CANN's optimized attention when available
    // This wraps aclnnFlashAttention or similar
    
    int64_t q_dims[] = {batch_size, num_heads, seq_len, head_dim};
    int64_t kv_dims[] = {batch_size, num_heads, seq_len, head_dim};
    
    aclTensorDesc* q_desc = aclCreateTensorDesc(ACL_FLOAT16, 4, q_dims, ACL_FORMAT_ND);
    aclTensorDesc* k_desc = aclCreateTensorDesc(ACL_FLOAT16, 4, kv_dims, ACL_FORMAT_ND);
    aclTensorDesc* v_desc = aclCreateTensorDesc(ACL_FLOAT16, 4, kv_dims, ACL_FORMAT_ND);
    aclTensorDesc* o_desc = aclCreateTensorDesc(ACL_FLOAT16, 4, q_dims, ACL_FORMAT_ND);
    
    // For now, fall back to matmul-based attention
    // Q @ K^T -> Softmax -> @ V
    
    aclDestroyTensorDesc(q_desc);
    aclDestroyTensorDesc(k_desc);
    aclDestroyTensorDesc(v_desc);
    aclDestroyTensorDesc(o_desc);
    
    return ACL_SUCCESS;
}

#endif  // __ASCEND__

#endif  // YIRAGE_BACKEND_ASCEND_ENABLED

