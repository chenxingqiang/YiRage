#pragma once

#include <sycl/sycl.hpp>
#include <sycl/ext/intel/experimental/esimd.hpp>

namespace yirage {
namespace kernel {
namespace xpu {

using namespace sycl;
namespace esimd = sycl::ext::intel::experimental::esimd;

// =============================================================================
// XMX-based GEMM Kernel (BF16)
// =============================================================================

template<int TILE_M = 32, int TILE_N = 64, int TILE_K = 16>
class GemmXmxKernel {
public:
    void operator()(
        nd_item<2> item,
        const sycl::ext::oneapi::bfloat16* A,
        const sycl::ext::oneapi::bfloat16* B,
        float* C,
        int M, int N, int K,
        local_accessor<float, 2> slm
    ) const {
        auto sg = item.get_sub_group();
        int sg_id = sg.get_group_id()[0];
        int sg_lane = sg.get_local_id()[0];
        
        int row = item.get_group(0) * TILE_M;
        int col = item.get_group(1) * TILE_N;
        
        float acc[TILE_M / 8][TILE_N / 16] = {0};
        
        for (int k = 0; k < K; k += TILE_K) {
            // Load A tile to SLM
            // Load B tile to SLM
            item.barrier(access::fence_space::local_space);
            
            // XMX DPAS computation
            // Uses Intel DPAS instructions for 8x16 systolic array
            #pragma unroll
            for (int kk = 0; kk < TILE_K; kk++) {
                // DPAS accumulate
            }
            
            item.barrier(access::fence_space::local_space);
        }
        
        // Store results
        for (int i = 0; i < TILE_M / 8; i++) {
            for (int j = 0; j < TILE_N / 16; j++) {
                // Write back to global memory
            }
        }
    }
};

// =============================================================================
// Launch wrapper
// =============================================================================

void gemm_bf16_xmx(
    queue& q,
    const sycl::ext::oneapi::bfloat16* A,
    const sycl::ext::oneapi::bfloat16* B,
    float* C,
    int M, int N, int K
) {
    constexpr int TILE_M = 32;
    constexpr int TILE_N = 64;
    constexpr int TILE_K = 16;
    constexpr int SIMD = 16;
    
    range<2> global{(M + TILE_M - 1) / TILE_M, (N + TILE_N - 1) / TILE_N * SIMD};
    range<2> local{1, SIMD};
    
    q.submit([&](handler& h) {
        local_accessor<float, 2> slm({TILE_M, TILE_K}, h);
        
        h.parallel_for<class gemm_xmx>(
            nd_range<2>{global, local},
            [=](nd_item<2> item) [[intel::reqd_sub_group_size(SIMD)]] {
                GemmXmxKernel<TILE_M, TILE_N, TILE_K>{}(
                    item, A, B, C, M, N, K, slm
                );
            }
        );
    });
}

// =============================================================================
// FP32 GEMM (fallback)
// =============================================================================

void gemm_f32(
    queue& q,
    const float* A,
    const float* B,
    float* C,
    int M, int N, int K
) {
    q.submit([&](handler& h) {
        h.parallel_for<class gemm_f32>(
            range<2>{M, N},
            [=](id<2> idx) {
                int m = idx[0];
                int n = idx[1];
                float sum = 0.0f;
                for (int k = 0; k < K; k++) {
                    sum += A[m * K + k] * B[k * N + n];
                }
                C[m * N + n] = sum;
            }
        );
    });
}

}  // namespace xpu
}  // namespace kernel
}  // namespace yirage
