// =============================================================================
// Unified Dispatch Function
// =============================================================================

aclError ascend_unary_f16(
    const void* input,
    void* output,
    int n,
    AscendUnaryOp op,
    aclrtStream stream
) {
    switch (op) {
        case ASCEND_RELU:
            return ascend_relu_f16(input, output, n, stream);
        case ASCEND_GELU:
        case ASCEND_GELU_TANH:
            return ascend_gelu_f16(input, output, n, stream);
        case ASCEND_SILU:
            return ascend_silu_f16(input, output, n, stream);
        case ASCEND_SIGMOID:
            return ascend_sigmoid_f16(input, output, n, stream);
        case ASCEND_TANH:
            return ascend_tanh_f16(input, output, n, stream);
        case ASCEND_EXP:
            return ascend_exp_f16(input, output, n, stream);
        case ASCEND_SQRT:
            return ascend_sqrt_f16(input, output, n, stream);
        default:
            return ACL_ERROR_INVALID_PARAM;
    }
}

// =============================================================================
// Fused Operations (SwiGLU)
// =============================================================================

aclError ascend_swiglu_f16(
    const void* gate,
    const void* up,
    void* output,
    int n,
    aclrtStream stream
) {
#ifdef YIRAGE_BACKEND_ASCEND_ENABLED
    // SwiGLU: silu(gate) * up
    // Can be fused for better performance
    
    // Temporary buffer for SiLU output
    void* silu_output = nullptr;
    size_t size = n * sizeof(float16_t);
    aclrtMalloc(&silu_output, size, ACL_MEM_MALLOC_NORMAL_ONLY);
    
    // Step 1: SiLU on gate
    aclError ret = ascend_silu_f16(gate, silu_output, n, stream);
    if (ret != ACL_SUCCESS) {
        aclrtFree(silu_output);
        return ret;
    }
    
    // Step 2: Element-wise multiply
    aclTensor* silu_tensor = nullptr;
    aclTensor* up_tensor = nullptr;
    aclTensor* out_tensor = nullptr;
    
    uint64_t workspace_size = 0;
    void* workspace = nullptr;
    aclOpExecutor* executor = nullptr;
    
    ret = aclnnMulGetWorkspaceSize(
        silu_tensor, up_tensor, out_tensor,
        &workspace_size, &executor
    );
    
    if (ret == ACL_SUCCESS) {
        if (workspace_size > 0) {
            aclrtMalloc(&workspace, workspace_size, ACL_MEM_MALLOC_NORMAL_ONLY);
        }
        ret = aclnnMul(workspace, workspace_size, executor, stream);
        if (workspace != nullptr) {
            aclrtFree(workspace);
        }
    }
    
    aclrtFree(silu_output);
    return ret;
#else
    return ACL_SUCCESS;
#endif
}

// =============================================================================
// Performance Estimation
// =============================================================================

struct AscendUnaryStats {
    double gbps;          // Memory bandwidth achieved
    double gops;          // Billion operations per second
    double utilization;   // Vector Unit utilization
};

AscendUnaryStats estimate_unary_performance(int n, AscendUnaryOp op, int device_type) {
    AscendUnaryStats stats;
    
    // Ascend 910: 1.2 TB/s memory bandwidth
    // Ascend 310: 256 GB/s memory bandwidth
    double peak_bandwidth = (device_type == 910) ? 1200.0 : 256.0;
    
    // Unary ops are memory-bound
    // Read + Write = 2 * n * sizeof(float16)
    double data_size = 2.0 * n * 2.0;  // bytes (FP16)
    
    // Simple operations (ReLU) achieve near-peak bandwidth
    // Complex operations (GELU, SiLU) are compute-limited
    double efficiency = 1.0;
    switch (op) {
        case ASCEND_RELU:
        case ASCEND_ABS:
        case ASCEND_NEG:
            efficiency = 0.95;
            break;
        case ASCEND_SIGMOID:
        case ASCEND_TANH:
            efficiency = 0.8;
            break;
        case ASCEND_GELU:
        case ASCEND_SILU:
            efficiency = 0.7;
            break;
        default:
            efficiency = 0.85;
    }
    
    stats.gbps = peak_bandwidth * efficiency;
    stats.utilization = efficiency;
    stats.gops = n / 1e9;  // Approximate
    
    return stats;
}

